(* qrgaka_leader.pv -- S3 leader-mandatory secrecy of the quorum secret S
 * Run: proverif -lib qrgaka_lib.pvl qrgaka_leader.pv

 *)

free idL: id.  free id1: id.  free id2: id.
free e0: epoch.

free yL: share [private].
free y1: share [private].
free y2: share [private].

query attacker(rec(yL, y1, y2)).

process
  new skL: skey; new sk1: skey; new sk2: skey;
  new ksL: key;  new ks1: key;  new ks2: key;
  new mu: share;
  let sigL = madd(yL, mu) in
  let sig1 = madd(y1, sigL) in
  let sig2 = madd(y2, sigL) in
  let kappa = chk((e0, rec(yL, y1, y2))) in
  let blobL = senc((yL, sigL), ksL, idb(idL)) in                  (* what MemRead(LU) returns *)
  out(c, (pk(skL), pk(sk1), pk(sk2), kappa));
  out(c, blobL);                                             (* MemRead(LU): sealed ciphertext only *)
  out(c, (sk1, sk2, ks1, ks2, sig1, sig2));                  (* Corrupt(all members) *)
  (* out(c, (yL, sigL));  <-- NEGATIVE CONTROL: unsealed (y_L, sigma_L); attacker(rec(yL,y1,y2)) becomes true *)
  ( !Leader(idL, skL, ksL, blobL, e0, kappa, id1, pk(sk1), id2, pk(sk2)) )
